{
  "name": "react-router-validated-search",
  "version": "0.1.0",
  "description": "Validated and typed search parameters for React Router Framework Mode",
  "keywords": [
    "query-params",
    "react-router",
    "search-params",
    "typescript",
    "vite"
  ],
  "homepage": "https://github.com/p-dubovitsky/react-router-validated-search#readme",
  "bugs": {
    "url": "https://github.com/p-dubovitsky/react-router-validated-search/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/p-dubovitsky/react-router-validated-search.git"
  },
  "bin": {
    "react-router-validated-search": "dist/cli/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./internal": {
      "types": "./dist/internal/index.d.ts",
      "default": "./dist/internal/index.js"
    },
    "./internal/codec": {
      "types": "./dist/internal/codec.d.ts",
      "default": "./dist/internal/codec.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "vp check",
    "prepack": "vp run build",
    "test": "vp test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@standard-schema/spec": "1.1.0",
    "magic-string": "0.30.21",
    "oxc-parser": "0.121.0"
  },
  "devDependencies": {
    "@react-router/dev": "8.3.0",
    "@testing-library/react": "16.2.0",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "happy-dom": "20.11.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-router": "8.3.0",
    "typescript": "6.0.3",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "zod": "4.0.5"
  },
  "peerDependencies": {
    "react": ">=19.2.7 <20",
    "react-router": ">=8.2.0 <9",
    "vite": ">=8 <9"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.22.0",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.11.0 <25",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
